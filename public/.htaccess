RewriteEngine On

# Canonicalize the production host in one hop; leave preview hosts alone.
RewriteCond %{HTTP_HOST} ^www\.vayucred\.com$ [NC]
RewriteRule ^ https://vayucred.com%{REQUEST_URI} [R=301,L,NE]

# Honor HTTPS forwarded by the hosting proxy to avoid redirect loops.
RewriteCond %{HTTP_HOST} ^vayucred\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteRule ^ https://vayucred.com%{REQUEST_URI} [R=301,L,NE]

# Retired brand assets are intentionally unavailable.
RewriteRule ^brand(?:/.*)?$ - [G,L,NC]

# Keep old public URLs on their current canonical routes.
RewriteCond %{THE_REQUEST} "^[A-Z]{3,9}\s/+index\.html(?:[?\s])" [NC]
RewriteRule ^index\.html$ / [R=301,L,NE]
RewriteRule ^index/?$ / [R=301,L,NE]
RewriteRule ^about\.html$ /about/ [R=301,L,NE]
RewriteRule ^contact\.html$ /contact/ [R=301,L,NE]
RewriteRule ^projects\.html$ / [R=301,L,NE]
RewriteRule ^careers\.html$ /contact/ [R=301,L,NE]
RewriteRule ^services-corporate\.html$ /buyers/ [R=301,L,NE]
RewriteRule ^services-mrv\.html$ /evidence-infrastructure/ [R=301,L,NE]

<IfModule mod_headers.c>
  # Apply HSTS to this host only; subdomain TLS is managed separately.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' mailto:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self'; upgrade-insecure-requests"

  <FilesMatch "^(index|__next.*)\.txt$">
    Header always set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>
